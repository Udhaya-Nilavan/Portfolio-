/**
 * ImpactSpotlight.tsx (v2, pinned scroll scene) — one self-contained file.
 *
 * Recreates the behaviour of the "Why us" block on lesmana.framer.website:
 * a dark portrait card pinned in the middle of the screen, four counters
 * either side of it, and a scroll-scrubbed sequence while it is pinned:
 *
 *   1. ENTER  the card rises into place, counters count up from 0, the
 *             heading words rise line by line.
 *   2. PIN    the scene stays fixed on screen while you scroll. Over that
 *             scroll distance the card BOX grows outward around content that
 *             keeps its size, and the counters drift outward + down and fade.
 *   3. RELEASE the section scrolls away normally.
 *
 * WHAT IS MEASURED vs ESTIMATED (please read)
 *   Measured from two screenshots of the live template (see MOTION below):
 *     - card box grows from 478x700 to 506x742 (+5.9% wide, +6.0% tall)
 *       while the text inside does not scale
 *     - the side counters end ~52px further out and ~53px lower
 *   Estimated (I could not watch the live page): the pin length, the exact
 *   easing, the final counter opacity, the entrance rise, and what happens
 *   after the last screenshot. Every one of these is a constant in MOTION.
 *   Nothing is copied from the template: no code, text, fonts or images.
 *
 * INTEGRATE
 *   Replace  src/sections/ImpactSpotlight.tsx  with this file. The export
 *   name and the <ImpactSpotlight /> usage in App.tsx stay the same, so no
 *   other file changes.
 *
 * CONTENT (all from your data, nothing invented)
 *   heading   personalData.statusBadge.label     paragraph personalData.shortStatement
 *   name      personalData.name                  chips     personalData.secondaryRoles
 *   counters  certificationsData.length, projectsData.length,
 *             achievementsData.length, personalData.coreDomains.length
 *   Every text and counter can be overridden with props.
 *
 * Import paths assume src/sections/. Only the four `../data/...` imports
 * would change if you move the file.
 *
 * DEPENDENCIES: React only. Reduced motion: honoured (no pin, no motion,
 * final values shown at once). Below 960px wide or 640px tall the scene is
 * not pinned and plays a one-shot reveal instead.
 */
import { useEffect, useId, useInsertionEffect, useRef, useState } from 'react';
import type { CSSProperties, PointerEvent as ReactPointerEvent } from 'react';
import { personalData } from '../data/personal';
import { certificationsData } from '../data/certifications';
import { projectsData } from '../data/projects';
import { achievementsData } from '../data/achievements';

/* ============================================================================
   MOTION — tune the animation here (no CSS editing needed)
============================================================================ */

const MOTION = {
  /** How long the scene stays pinned, as % of the viewport height. ESTIMATED. */
  pinDistanceVh: 120,
  /** Card box growth at the end of the pin. MEASURED: 478->506px, 700->742px. */
  cardGrowX: 0.0586,
  cardGrowY: 0.06,
  /** Counter drift at the end of the pin, in px. MEASURED. */
  statDriftX: 52,
  statDriftY: 53,
  /** Counter opacity left at the end of the pin (0-1). ESTIMATED from colour. */
  statFadeTo: 0.3,
  /** Card rise on entrance, in px. ESTIMATED. */
  enterRise: 90,
  /** Counter count-up duration in ms. ESTIMATED. */
  countDuration: 1500,
} as const;

/* ============================================================================
   Public types
============================================================================ */

export interface SpotlightStat {
  value: number;
  /** Shown before the number, e.g. "$". */
  prefix?: string;
  /** Shown after the number, e.g. "+" or "K+". */
  suffix?: string;
  label: string;
}

export interface ImpactSpotlightProps {
  /** DOM id. Omit unless you also add it to data/sections.ts. */
  id?: string;
  eyebrow?: string;
  heading?: string;
  description?: string;
  /** Name shown at the bottom of the card. */
  name?: string;
  /** Small caption under the name. */
  caption?: string;
  /** Words looping through the middle of the card. */
  chips?: string[];
  /** Counters. The first half go left of the card, the rest go right. */
  stats?: SpotlightStat[];
}

/* ============================================================================
   Defaults — derived from the portfolio's real data
============================================================================ */

function buildDefaultStats(): SpotlightStat[] {
  const stats: SpotlightStat[] = [
    { value: certificationsData.length, label: 'Credentials recorded' },
    { value: projectsData.length, label: 'Projects built' },
    { value: achievementsData.length, label: 'Verified platform achievements' },
    { value: personalData.coreDomains.length, label: 'Core AI & data domains' },
  ];
  return stats.filter(stat => stat.value > 0);
}

/* ============================================================================
   Motion mode
     reduced : no motion at all
     static  : phones / short screens — one-shot reveal, no pinning
     pinned  : desktop — pinned scene scrubbed by scroll position
============================================================================ */

type Mode = 'reduced' | 'static' | 'pinned';

const REDUCED_QUERY = '(prefers-reduced-motion: reduce)';
const PIN_QUERY = '(min-width: 960px) and (min-height: 640px)';

function readMode(): Mode {
  if (typeof window === 'undefined' || typeof window.matchMedia !== 'function') return 'static';
  if (window.matchMedia(REDUCED_QUERY).matches) return 'reduced';
  return window.matchMedia(PIN_QUERY).matches ? 'pinned' : 'static';
}

function useMotionMode(): Mode {
  const [mode, setMode] = useState<Mode>(readMode);

  useEffect(() => {
    if (typeof window.matchMedia !== 'function') return;
    const queries = [window.matchMedia(REDUCED_QUERY), window.matchMedia(PIN_QUERY)];
    const onChange = () => setMode(readMode());
    queries.forEach(q => q.addEventListener('change', onChange));
    onChange();
    return () => queries.forEach(q => q.removeEventListener('change', onChange));
  }, []);

  return mode;
}

const clamp01 = (n: number): number => Math.min(1, Math.max(0, n));
const easeOutCubic = (t: number): number => 1 - Math.pow(1 - t, 3);

/* ============================================================================
   Style injection — the CSS below is added to <head> exactly once
============================================================================ */

const STYLE_ID = 'ispot-styles-v2';

function useInjectStyles(): void {
  useInsertionEffect(() => {
    if (typeof document === 'undefined' || document.getElementById(STYLE_ID)) return;
    const el = document.createElement('style');
    el.id = STYLE_ID;
    el.textContent = CSS;
    document.head.appendChild(el);
  }, []);
}

/** Motion constants exposed to CSS. Defined once so React never rewrites them. */
const ROOT_STYLE = {
  '--ispot-pin-distance': `${MOTION.pinDistanceVh}vh`,
  '--ispot-grow-x': MOTION.cardGrowX,
  '--ispot-grow-y': MOTION.cardGrowY,
  '--ispot-drift-x': `${MOTION.statDriftX}px`,
  '--ispot-drift-y': `${MOTION.statDriftY}px`,
  '--ispot-fade': 1 - MOTION.statFadeTo,
  '--ispot-rise': `${MOTION.enterRise}px`,
} as CSSProperties;

/* ============================================================================
   Counter — writes straight to the DOM so it never re-renders per frame
============================================================================ */

interface CountUpProps {
  to: number;
  run: boolean;
  delay: number;
  instant: boolean;
}

function CountUp({ to, run, delay, instant }: CountUpProps) {
  const ref = useRef<HTMLSpanElement>(null);

  useEffect(() => {
    const node = ref.current;
    if (!node) return;

    if (instant) {
      node.textContent = String(to);
      return;
    }
    if (!run) {
      node.textContent = '0';
      return;
    }

    let frame = 0;
    let startedAt = 0;

    const tick = (now: number) => {
      if (!startedAt) startedAt = now;
      const k = Math.min(1, (now - startedAt) / MOTION.countDuration);
      node.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 4))));
      if (k < 1) frame = requestAnimationFrame(tick);
    };

    const timer = window.setTimeout(() => {
      frame = requestAnimationFrame(tick);
    }, delay);

    return () => {
      window.clearTimeout(timer);
      cancelAnimationFrame(frame);
    };
  }, [to, run, delay, instant]);

  // The child is a constant so React never rewrites the text the effect sets.
  return (
    <span ref={ref} className="ispot__count">
      0
    </span>
  );
}

/* ============================================================================
   One column of counters
============================================================================ */

interface StatColumnProps {
  side: 'left' | 'right';
  stats: SpotlightStat[];
  startIndex: number;
  run: boolean;
  instant: boolean;
}

function StatColumn({ side, stats, startIndex, run, instant }: StatColumnProps) {
  return (
    <ul className={`ispot__stats ispot__stats--${side}`} role="list">
      {stats.map((stat, i) => {
        const index = startIndex + i;
        const prefix = stat.prefix ?? '';
        const suffix = stat.suffix ?? '';
        const style = { '--d': index * 110 } as CSSProperties;

        return (
          <li key={stat.label} className="ispot__stat" style={style}>
            <p className="ispot__num">
              <span aria-hidden="true">
                {prefix}
                <CountUp to={stat.value} run={run} delay={index * 110} instant={instant} />
                {suffix}
              </span>
              <span className="ispot__sr">
                {prefix}
                {stat.value}
                {suffix}
              </span>
            </p>
            <p className="ispot__label">{stat.label}</p>
          </li>
        );
      })}
    </ul>
  );
}

/* ============================================================================
   Marquee row
============================================================================ */

function ChipRow({ items, reverse }: { items: string[]; reverse?: boolean }) {
  if (items.length === 0) return null;
  return (
    <div className={`ispot__row${reverse ? ' ispot__row--rev' : ''}`}>
      <div className="ispot__track">
        <div className="ispot__set">
          {items.map(item => (
            <span key={item} className="ispot__chip">
              {item}
            </span>
          ))}
        </div>
        <div className="ispot__set" aria-hidden="true">
          {items.map(item => (
            <span key={item} className="ispot__chip">
              {item}
            </span>
          ))}
        </div>
      </div>
    </div>
  );
}

/* ============================================================================
   Component
============================================================================ */

export function ImpactSpotlight({
  id,
  eyebrow = 'At a glance',
  heading = personalData.statusBadge.label,
  description = personalData.shortStatement,
  name = personalData.name,
  caption = 'Verified portfolio',
  chips = personalData.secondaryRoles,
  stats,
}: ImpactSpotlightProps) {
  useInjectStyles();

  const mode = useMotionMode();
  const headingId = useId();
  const rootRef = useRef<HTMLElement>(null);
  const spot = useRef({ frame: 0 });
  const [revealed, setRevealed] = useState<boolean>(mode === 'reduced');
  const [live, setLive] = useState(false);

  const allStats = stats ?? buildDefaultStats();
  const split = Math.ceil(allStats.length / 2);
  const leftStats = allStats.slice(0, split);
  const rightStats = allStats.slice(split);

  const half = Math.ceil(chips.length / 2);
  const rowA = chips.slice(0, half);
  const rowB = chips.slice(half);

  /* ---- Scroll-scrubbed scene ---------------------------------------------- */
  useEffect(() => {
    const root = rootRef.current;
    if (!root) return;

    const setVar = (key: string, value: number) => root.style.setProperty(key, value.toFixed(4));

    if (mode === 'reduced') {
      setVar('--ispot-e', 1);
      setVar('--ispot-p', 0);
      setRevealed(true);
      return;
    }

    if (mode === 'static') {
      setVar('--ispot-p', 0);
      const reveal = () => {
        setVar('--ispot-e', 1);
        setRevealed(true);
      };
      if (typeof IntersectionObserver === 'undefined') {
        reveal();
        return;
      }
      const observer = new IntersectionObserver(
        entries => {
          if (entries.some(entry => entry.isIntersecting)) {
            reveal();
            observer.disconnect();
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
      );
      observer.observe(root);
      return () => observer.disconnect();
    }

    // pinned
    let frame = 0;
    let lastE = -1;
    let lastP = -1;
    let flagged = false;

    const update = () => {
      frame = 0;
      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight || 1;

      // ENTER: 0 when the section's top is at the bottom edge, 1 when it reaches the top.
      const enterRaw = clamp01((vh - rect.top) / vh);
      const e = easeOutCubic(enterRaw);

      // PIN: 0 when the scene locks to the screen, 1 when it is about to be released.
      const travel = Math.max(1, rect.height - vh);
      const p = clamp01(-rect.top / travel);

      if (Math.abs(e - lastE) > 0.0005) {
        lastE = e;
        setVar('--ispot-e', e);
      }
      if (Math.abs(p - lastP) > 0.0005) {
        lastP = p;
        setVar('--ispot-p', p);
      }
      if (!flagged && enterRaw >= 0.55) {
        flagged = true;
        setRevealed(true);
      }
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();

    return () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      cancelAnimationFrame(frame);
    };
  }, [mode]);

  /* ---- Pause the marquee and pulse while off-screen ----------------------- */
  useEffect(() => {
    const root = rootRef.current;
    if (!root || mode === 'reduced') {
      setLive(false);
      return;
    }
    if (typeof IntersectionObserver === 'undefined') {
      setLive(true);
      return;
    }
    const observer = new IntersectionObserver(
      entries => {
        const last = entries[entries.length - 1];
        if (last) setLive(last.isIntersecting);
      },
      { rootMargin: '10% 0px' },
    );
    observer.observe(root);
    return () => observer.disconnect();
  }, [mode]);

  useEffect(() => {
    const state = spot.current;
    return () => cancelAnimationFrame(state.frame);
  }, []);

  /* ---- Cursor-following highlight on the card ----------------------------- */
  const onCardMove = (event: ReactPointerEvent<HTMLElement>) => {
    if (mode === 'reduced' || event.pointerType === 'touch') return;
    const card = event.currentTarget;
    const rect = card.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) return;
    const x = ((event.clientX - rect.left) / rect.width) * 100;
    const y = ((event.clientY - rect.top) / rect.height) * 100;
    if (spot.current.frame) cancelAnimationFrame(spot.current.frame);
    spot.current.frame = requestAnimationFrame(() => {
      spot.current.frame = 0;
      card.style.setProperty('--mx', `${x.toFixed(1)}%`);
      card.style.setProperty('--my', `${y.toFixed(1)}%`);
    });
  };

  const onCardLeave = (event: ReactPointerEvent<HTMLElement>) => {
    const card = event.currentTarget;
    card.style.removeProperty('--mx');
    card.style.removeProperty('--my');
  };

  const instant = mode === 'reduced';
  const words = heading.split(' ').filter(Boolean);

  return (
    <section
      ref={rootRef}
      id={id}
      className="ispot"
      style={ROOT_STYLE}
      data-mode={mode}
      data-revealed={revealed ? 'true' : 'false'}
      data-live={live ? 'true' : 'false'}
      aria-labelledby={headingId}
    >
      <div className="ispot__pin">
        <div className="ispot__grid" aria-hidden="true" />

        <div className="ispot__inner">
          <div className="ispot__stage">
            <StatColumn side="left" stats={leftStats} startIndex={0} run={revealed} instant={instant} />

            <article className="ispot__card" onPointerMove={onCardMove} onPointerLeave={onCardLeave}>
              <div className="ispot__card-bg" aria-hidden="true" />

              <div className="ispot__card-body">
                <div className="ispot__top">
                  <p className="ispot__eyebrow">
                    <span className="ispot__dot" aria-hidden="true" />
                    {eyebrow}
                  </p>
                  <h2 id={headingId} className="ispot__heading">
                    {words.map((word, i) => (
                      <span key={`${word}-${i}`}>
                        <span className="ispot__w">
                          <span className="ispot__wi" style={{ '--i': i } as CSSProperties}>
                            {word}
                          </span>
                        </span>{' '}
                      </span>
                    ))}
                  </h2>
                </div>

                <div className="ispot__mid" aria-hidden="true">
                  <ChipRow items={rowA} />
                  <ChipRow items={rowB} reverse />
                </div>

                <div className="ispot__foot">
                  <div className="ispot__sign">
                    <span className="ispot__name">{name}</span>
                    <span className="ispot__caption">{caption}</span>
                  </div>
                  <p className="ispot__desc">{description}</p>
                </div>
              </div>
            </article>

            <StatColumn
              side="right"
              stats={rightStats}
              startIndex={leftStats.length}
              run={revealed}
              instant={instant}
            />
          </div>
        </div>
      </div>
    </section>
  );
}

export default ImpactSpotlight;

/* ============================================================================
   CSS — every selector is prefixed `ispot` so nothing else on the page is
   touched. Colours come only from the site's own tokens.
============================================================================ */

const CSS = `
.ispot {
  --ispot-e: 0;   /* entrance progress 0..1, set by scroll */
  --ispot-p: 0;   /* pin progress 0..1, set by scroll */
  position: relative;
  isolation: isolate;
}
.ispot[data-mode='reduced'] { --ispot-e: 1; --ispot-p: 0; }

/* ---- Pinned stage --------------------------------------------------------- */
.ispot__pin {
  position: relative;
  padding-block: var(--section-y, 6rem);
}
.ispot[data-mode='pinned'] {
  height: calc(100vh + var(--ispot-pin-distance, 120vh));
  height: calc(100svh + var(--ispot-pin-distance, 120vh));
}
.ispot[data-mode='pinned'] .ispot__pin {
  position: sticky;
  top: 0;
  height: 100vh;
  height: 100svh;
  padding-block: 0;
  display: flex;
  align-items: center;
}

/* ---- Faded grid backdrop ------------------------------------------------- */
.ispot__grid {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image:
    linear-gradient(color-mix(in srgb, var(--fg, #090d16) 7%, transparent) 1px, transparent 1px),
    linear-gradient(90deg, color-mix(in srgb, var(--fg, #090d16) 7%, transparent) 1px, transparent 1px);
  background-size: 44px 44px;
  -webkit-mask-image: radial-gradient(ellipse 58% 52% at 50% 50%, #000 0%, transparent 72%);
  mask-image: radial-gradient(ellipse 58% 52% at 50% 50%, #000 0%, transparent 72%);
  opacity: var(--ispot-e);
}

.ispot__inner {
  position: relative;
  width: 100%;
  max-width: var(--maxw, 1180px);
  margin-inline: auto;
  padding-inline: clamp(1.1rem, 4vw, 2.5rem);
}

/* ---- Layout -------------------------------------------------------------- */
.ispot__stage {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: clamp(2.5rem, 7vw, 3.25rem);
  align-items: stretch;
}
.ispot__card { order: -1; }

.ispot__stats {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.75rem 1.5rem;
}

@media (min-width: 960px) {
  .ispot__stage {
    grid-template-columns: minmax(0, 1fr) clamp(19rem, 31vw, 28rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4.5rem);
  }
  .ispot__card { order: 0; }
  .ispot__stats {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(1.5rem, 7vh, 4.5rem);
  }
  .ispot__stats--left { text-align: right; }
  .ispot__stats--left .ispot__label { margin-left: auto; }
  .ispot__stats--left .ispot__label::before { margin-left: auto; }
}

/* ---- Counters: they drift outward + down and fade while the scene is pinned */
.ispot__stat {
  --dir: -1;
  opacity: calc(var(--ispot-e) * (1 - var(--ispot-p) * var(--ispot-fade, 0.7)));
  transform: translate3d(
    calc(var(--dir) * var(--ispot-p) * var(--ispot-drift-x, 52px)),
    calc((1 - var(--ispot-e)) * 28px + var(--ispot-p) * var(--ispot-drift-y, 53px)),
    0
  );
}
.ispot__stats--right .ispot__stat { --dir: 1; }

.ispot__num {
  margin: 0;
  font-family: var(--font-display, system-ui, sans-serif);
  font-weight: 500;
  font-size: clamp(3rem, 1.5rem + 4.4vw, 5.75rem);
  line-height: 0.95;
  letter-spacing: -0.045em;
  color: var(--fg, #090d16);
  font-variant-numeric: tabular-nums;
}
.ispot__label {
  margin: 0.9rem 0 0;
  max-width: 26ch;
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 0.72rem;
  line-height: 1.75;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--subtle-fg, #475467);
}
.ispot__label::before {
  content: '';
  display: block;
  width: 22px;
  height: 2px;
  margin-bottom: 0.7rem;
  border-radius: 2px;
  background: linear-gradient(90deg, var(--accent-color, #090d16), var(--secondary-accent-color, #2563eb));
}
.ispot__sr {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

/* ---- Card ---------------------------------------------------------------- */
/* The card is two layers: a background BOX that grows, and a BODY whose
   content keeps its size — this is what makes the box expand around the text. */
.ispot__card {
  position: relative;
  isolation: isolate;
  container-type: inline-size;
  width: 100%;
  max-width: 34rem;
  min-height: clamp(30rem, 64vh, 42rem);
  min-height: min(42rem, 74svh);
  margin-inline: auto;
  color: var(--on-accent, #fff);
  opacity: var(--ispot-e);
  transform: translate3d(0, calc((1 - var(--ispot-e)) * var(--ispot-rise, 90px)), 0);
}
@media (min-width: 960px) {
  .ispot__card { max-width: none; }
}
.ispot__card-bg {
  position: absolute;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  border-radius: var(--radius-xl, 28px);
  background: var(--accent-color, #090d16);
  border: 1px solid color-mix(in srgb, var(--on-accent, #fff) 10%, var(--accent-color, #090d16));
  box-shadow: 0 40px 80px -32px rgba(9, 13, 22, 0.45), 0 12px 24px -12px rgba(9, 13, 22, 0.25);
  transform: scale(
    calc(1 + var(--ispot-p) * var(--ispot-grow-x, 0.0586)),
    calc(1 + var(--ispot-p) * var(--ispot-grow-y, 0.06))
  );
  will-change: transform;
}
.ispot__card-bg::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(
    420px circle at var(--mx, 50%) var(--my, 18%),
    color-mix(in srgb, var(--on-accent, #fff) 10%, transparent),
    transparent 62%
  );
}
.ispot__card-body {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 2rem;
  min-height: inherit;
  padding: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
}

.ispot__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  margin: 0 0 1.1rem;
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 0.74rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--amber, #d97706) 65%, var(--on-accent, #fff));
  opacity: 0;
  transform: translate3d(0, 10px, 0);
  transition: opacity 700ms var(--ease-out, ease) 100ms, transform 700ms var(--ease-out, ease) 100ms;
}
.ispot__dot {
  position: relative;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--amber, #d97706);
}
.ispot__dot::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: var(--amber, #d97706);
  opacity: 0;
}
.ispot[data-live='true'] .ispot__dot::after {
  animation: ispot-pulse 2.6s ease-out infinite;
}

.ispot__heading {
  margin: 0;
  font-family: var(--font-display, system-ui, sans-serif);
  font-weight: 600;
  font-size: clamp(1.7rem, 1.1rem + 1.7vw, 2.55rem);
  font-size: clamp(1.45rem, 11cqi, 2.55rem); /* scales with the card, so long words never overflow */
  line-height: 1.1;
  letter-spacing: -0.035em;
  overflow-wrap: break-word;
  color: var(--on-accent, #fff);
  text-wrap: balance;
}
.ispot__w {
  display: inline-block;
  overflow: hidden;
  vertical-align: top;
  padding-bottom: 0.14em;
  margin-bottom: -0.14em;
}
.ispot__wi {
  display: inline-block;
  transform: translate3d(0, 112%, 0);
  transition: transform 900ms var(--ease-out, ease) calc(var(--i, 0) * 55ms + 180ms);
}

/* ---- Marquee ------------------------------------------------------------- */
.ispot__mid {
  display: grid;
  gap: 0.7rem;
  align-content: center;
  opacity: 0;
  transition: opacity 900ms var(--ease-out, ease) 500ms;
}
.ispot__row {
  overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
}
.ispot__track {
  display: flex;
  width: max-content;
  animation: ispot-march 38s linear infinite;
  animation-play-state: paused;
}
.ispot__row--rev .ispot__track {
  animation-direction: reverse;
  animation-duration: 46s;
}
.ispot[data-live='true'] .ispot__track { animation-play-state: running; }
.ispot__card:hover .ispot__track { animation-play-state: paused; }
.ispot__set {
  display: flex;
  gap: 0.6rem;
  padding-right: 0.6rem;
}
.ispot__chip {
  display: inline-block;
  padding: 0.42rem 0.9rem;
  border-radius: var(--radius-pill, 999px);
  border: 1px solid color-mix(in srgb, var(--on-accent, #fff) 22%, transparent);
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
  color: color-mix(in srgb, var(--on-accent, #fff) 86%, var(--accent-color, #090d16));
}

/* ---- Footer: name + paragraph -------------------------------------------- */
.ispot__foot {
  display: grid;
  gap: 1.25rem;
  align-items: end;
}
.ispot__sign {
  display: grid;
  gap: 0.35rem;
  opacity: 0;
  transform: translate3d(0, 12px, 0);
  transition: opacity 800ms var(--ease-out, ease) 650ms, transform 800ms var(--ease-out, ease) 650ms;
}
.ispot__name {
  font-family: var(--font-display, system-ui, sans-serif);
  font-weight: 600;
  font-size: clamp(1.25rem, 1rem + 0.9vw, 1.7rem);
  letter-spacing: -0.03em;
  color: var(--on-accent, #fff);
}
.ispot__caption {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--on-accent, #fff) 66%, var(--accent-color, #090d16));
}
.ispot__desc {
  margin: 0;
  font-size: var(--step--1, 0.84rem);
  line-height: 1.65;
  color: color-mix(in srgb, var(--on-accent, #fff) 80%, var(--accent-color, #090d16));
  opacity: 0;
  transform: translate3d(0, 12px, 0);
  transition: opacity 800ms var(--ease-out, ease) 800ms, transform 800ms var(--ease-out, ease) 800ms;
}

/* ---- Revealed state (text, marquee, name) -------------------------------- */
.ispot[data-revealed='true'] .ispot__eyebrow,
.ispot[data-revealed='true'] .ispot__mid,
.ispot[data-revealed='true'] .ispot__sign,
.ispot[data-revealed='true'] .ispot__desc { opacity: 1; transform: none; }
.ispot[data-revealed='true'] .ispot__wi { transform: none; }

/* ---- One-shot entrance on phones / short screens ------------------------- */
.ispot[data-mode='static'] .ispot__card,
.ispot[data-mode='static'] .ispot__grid {
  transition: opacity 900ms var(--ease-out, ease), transform 1000ms var(--ease-out, ease);
}
.ispot[data-mode='static'] .ispot__stat {
  transition:
    opacity 800ms var(--ease-out, ease) calc(var(--d, 0) * 1ms + 250ms),
    transform 900ms var(--ease-out, ease) calc(var(--d, 0) * 1ms + 250ms);
}

/* ---- Keyframes ----------------------------------------------------------- */
@keyframes ispot-march { to { transform: translate3d(-50%, 0, 0); } }
@keyframes ispot-pulse {
  0%   { opacity: 0.55; transform: scale(1); }
  100% { opacity: 0;    transform: scale(3); }
}

/* ---- Reduced motion: everything visible, nothing moves ------------------- */
.ispot[data-mode='reduced'] *,
.ispot[data-mode='reduced'] *::before,
.ispot[data-mode='reduced'] *::after {
  transition: none !important;
  animation: none !important;
}
.ispot[data-mode='reduced'] .ispot__eyebrow,
.ispot[data-mode='reduced'] .ispot__mid,
.ispot[data-mode='reduced'] .ispot__sign,
.ispot[data-mode='reduced'] .ispot__desc { opacity: 1; transform: none; }
.ispot[data-mode='reduced'] .ispot__wi { transform: none; }
.ispot[data-mode='reduced'] .ispot__track { width: auto; flex-wrap: wrap; }
.ispot[data-mode='reduced'] .ispot__set { flex-wrap: wrap; }
.ispot[data-mode='reduced'] .ispot__set[aria-hidden='true'] { display: none; }
.ispot[data-mode='reduced'] .ispot__row { -webkit-mask-image: none; mask-image: none; }
@media (prefers-reduced-motion: reduce) {
  .ispot *, .ispot *::before, .ispot *::after { animation: none !important; }
}
`;
